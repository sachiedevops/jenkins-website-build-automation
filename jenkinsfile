
pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                echo 'Hello! Jenkins is connected to GitHub.'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying our website...'
                sh 'cp index.html /var/www/html/index.html'
                echo 'Website deployed successfully!'
            }
        }
    }
}

