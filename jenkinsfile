
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo 'Code downloaded from GitHub'
            }
        }

        stage('Deploy') {
            steps {
                sh 'cp index.html /var/www/html/index.html'
                sh 'chmod 644 /var/www/html/index.html'
                echo 'Website deployed successfully!'
            }
        }

    }
}

            echo 'Pipeline failed. Check the stage output above.'
        }
    }
}
